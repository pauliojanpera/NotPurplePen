<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IntegrationWorktree Condition="'$(IntegrationWorktree)' == ''">$(HOME)/Documents/Projects/npp-worktrees/palette-stack-int</IntegrationWorktree>
    <NoWarn>$(NoWarn);CS8632;NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(IntegrationWorktree)/src/MapModel/Graphics2D/Graphics2D.csproj" />
    <ProjectReference Include="$(IntegrationWorktree)/src/MapModel/MapModel/MapModel.csproj" />
    <ProjectReference Include="$(IntegrationWorktree)/src/MapModel/Map_SkiaStd/Map_SkiaStd.csproj" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.5" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Test settings for CI. Combines the two checked-in runsettings: silent like
  src/.runsettings, serial like src/ShowUi.runsettings.

  Parallelism has to be off. AssemblyInfo.cs opts the assembly into
  method-level parallelism, and the classes that build WinForms UI opt back
  out with DoNotParallelize. CompatibilityTests does not, even though each of
  its tests constructs a MainFrame. Concurrent MainFrame construction races in
  WinForms' own KeysConverter, whose localized-key dictionary is not
  thread-safe, and the unhandled exception takes the test host down.
-->
<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <EnvironmentVariables>
      <TEST_SILENTRUN>True</TEST_SILENTRUN>
    </EnvironmentVariables>
  </RunConfiguration>

  <MSTest>
    <Parallelize>
      <Workers>1</Workers>
      <Scope>ClassLevel</Scope>
    </Parallelize>
  </MSTest>
</RunSettings>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes maps and their courses as SVG. It references Graphics2D and the map model, whose palette colors its
       encoding writes, and no renderer, so that it can be translated with the map model. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>PurplePen.MapModel</RootNamespace>
    <Configurations>Debug;Release;StorePkg</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Graphics2D\Graphics2D.csproj" />
    <ProjectReference Include="..\MapModel\MapModel.csproj" />
  </ItemGroup>
</Project>

<!--
    PublishCoursesDialog.axaml

    Dialog for publishing courses: a course list, and behind an Advanced
    button the folder they are published into and how their images are
    written.

    Migrated from WinForms PurplePen/PublishCoursesDialog.cs.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:views="using:AvPurplePen.Views"
        xmlns:resx="using:AvPurplePen"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="AvPurplePen.Views.PublishCoursesDialog"
        Classes="dialog"
        x:DataType="vm:PublishCoursesDialogViewModel"
        Title="{resx:Localize PublishCoursesDialog_Text}"
        Icon="/Assets/transparent.ico"
        d:DesignWidth="440" d:DesignHeight="500"
        Width="440" Height="500"
        CanResize="True"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:PublishCoursesDialogViewModel/>
    </Design.DataContext>

    <DockPanel Margin="12">

        <!-- OK / Cancel buttons at the bottom -->
        <UniformGrid DockPanel.Dock="Bottom"
                     Rows="1"
                     HorizontalAlignment="Right"
                     ColumnSpacing="8"
                     Margin="0,12,0,0">
            <Button x:Name="okButton"
                    Content="{resx:Localize OKButton}"
                    MinWidth="85"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"
                    Click="OkButton_Click"/>
            <Button x:Name="cancelButton"
                    Content="{resx:Localize CancelButton}"
                    MinWidth="85"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </UniformGrid>

        <!-- Advanced button. Reveals the group below and then disappears, so
             the two never take up space at once. -->
        <Button x:Name="advancedSettingsButton"
                DockPanel.Dock="Bottom"
                Classes="Small"
                Content="{resx:Localize PublishCoursesDialog_advancedSettingsButton_Text}"
                HorizontalAlignment="Left"
                Margin="0,8,0,0"
                IsVisible="{Binding IsAdvancedButtonVisible}"
                Command="{Binding RevealAdvancedSettingsCommand}"/>

        <!-- How the course images are written. Only the JPEGs take these; the
             PDFs the same publish writes have neither. -->
        <HeaderedContentControl DockPanel.Dock="Bottom"
                                Header="{resx:Localize PublishCoursesDialog_imageFilesGroupBox_Text}"
                                Padding="8"
                                Margin="0,8,0,0"
                                IsVisible="{Binding ShowAdvanced}">
            <Grid ColumnDefinitions="Auto,8,*"
                  RowDefinitions="Auto,4,Auto">

                <!-- Row 0: Auto rotate -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{resx:Localize PublishCoursesDialog_labelAutoRotate_Text}"
                           VerticalAlignment="Center"/>
                <CheckBox x:Name="autoRotateCheckBox"
                          Grid.Row="0" Grid.Column="2"
                          IsChecked="{Binding AutoRotate, Mode=TwoWay}"/>

                <!-- Row 2: Image quality -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{resx:Localize PublishCoursesDialog_labelImageQuality_Text}"
                           VerticalAlignment="Center"/>
                <NumericUpDown x:Name="imageQualityUpDown"
                               Grid.Row="2" Grid.Column="2"
                               Minimum="1" Maximum="100" Increment="1" FormatString="0"
                               HorizontalAlignment="Left" Width="100"
                               Value="{Binding Quality, Mode=TwoWay}"/>
            </Grid>
        </HeaderedContentControl>

        <!-- Publish target folder. The two checkboxes only apply to a relative
             path, so a rooted one disables them. -->
        <HeaderedContentControl DockPanel.Dock="Bottom"
                                Header="{resx:Localize PublishCoursesDialog_publishTargetFolderGroupBox_Text}"
                                Padding="8"
                                Margin="0,8,0,0"
                                IsVisible="{Binding ShowAdvanced}">
            <StackPanel Spacing="4">
                <TextBox x:Name="publishTargetFolderTextBox"
                         Text="{Binding PublishTargetFolder, Mode=TwoWay}"/>
                <Button x:Name="selectDataExchangeFolderButton"
                        Classes="Small"
                        Content="{resx:Localize PublishCoursesDialog_selectDataExchangeFolderButton_Text}"
                        HorizontalAlignment="Right"
                        Click="SelectDataExchangeFolderButton_Click"/>
                <CheckBox x:Name="fileDirectory"
                          Content="{resx:Localize PublishCoursesDialog_fileDirectory_Text}"
                          IsEnabled="{Binding IsRelativePath}"
                          IsChecked="{Binding UseFileDirectory, Mode=TwoWay}"/>
                <CheckBox x:Name="mapDirectory"
                          Content="{resx:Localize PublishCoursesDialog_mapDirectory_Text}"
                          IsEnabled="{Binding IsRelativePath}"
                          IsChecked="{Binding UseMapDirectory, Mode=TwoWay}"/>
            </StackPanel>
        </HeaderedContentControl>

        <!-- Courses fill whatever is left -->
        <HeaderedContentControl Header="{resx:Localize PublishCoursesDialog_coursesGroupBox_Text}"
                                Padding="8,10,8,8">
            <views:CourseSelector x:Name="courseSelector"
                                  EventDB="{Binding EventDB}"
                                  ShowAllControls="True"
                                  ShowCourseParts="False"
                                  ShowVariationChooser="True"/>
        </HeaderedContentControl>

    </DockPanel>
</Window>

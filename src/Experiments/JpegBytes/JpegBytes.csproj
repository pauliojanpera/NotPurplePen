<Project Sdk="Microsoft.NET.Sdk">

  <!-- Encodes test images as JPEG through the Skia bitmaps' WriteToStream, as the SVG export does, and prints the
       SHA-256 of each, so that the bytes can be compared between machines. A throwaway experiment. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MapModel\Graphics2D\Graphics2D.csproj" />
    <ProjectReference Include="..\..\MapModel\Map_SkiaStd\Map_SkiaStd.csproj" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
  </ItemGroup>
</Project>
